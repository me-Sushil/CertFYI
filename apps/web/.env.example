# Secret used to sign session JWTs - generate with e.g. `openssl rand -base64 32`
JWT_SECRET=replace-with-a-random-32-byte-secret

# Server-side RPC endpoint used to verify on-chain grantRole transactions
# when an admin approves an issuer (not exposed to the client)
RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY

# Public config
