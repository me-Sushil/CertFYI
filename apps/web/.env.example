# Base URL of the CertFyi API (apps/api) that the web app talks to
NEXT_PUBLIC_API_URL=http://localhost:3001/api
# Same value, read server-side by proxy.ts (falls back to NEXT_PUBLIC_API_URL if unset)
API_URL=http://localhost:3001/api

# Public config
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=your_walletconnect_project_id_here
NEXT_PUBLIC_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_CHAIN_ID=11155111
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ENABLE_TESTNETS=true

# Public IPFS gateway used to build CID links in the browser.
# Must match the API's IPFS_GATEWAY_URL.
NEXT_PUBLIC_IPFS_GATEWAY_URL=https://your-gateway-subdomain.mypinata.cloud