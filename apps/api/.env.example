# --- Database ---
# PostgreSQL connection string used by Prisma
# ⚠️ Replace with your own connection string — the value below was committed in error
# and should be rotated before this repo goes public.
DATABASE_URL=postgresql://user:password@localhost:5432/certfyi

# --- Admin ---
# Wallet address bootstrapped as the platform Admin (lowercase-compared)
ADMIN_WALLET_ADDRESS=0x0000000000000000000000000000000000000000

# --- Session Auth ---
# Secret used to sign session JWTs - generate with e.g. `openssl rand -base64 32`
JWT_SECRET=replace-with-a-random-32-byte-secret

# --- Blockchain ---
# Server-side RPC endpoint used to verify on-chain grantRole / revokeRole transactions
RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY

# On-chain contract configuration (falls back to the NEXT_PUBLIC_* equivalents if unset)
CONTRACT_ADDRESS=
CHAIN_ID=11155111

# --- CORS ---
# Origin allowed to make credentialed requests (CORS)
WEB_APP_URL=http://localhost:3000

# --- Server ---
# Port the NestJS server listens on
PORT=3001

# --- API documentation (Swagger / OpenAPI) ---
# Serves Swagger UI at /docs, with the raw spec at /docs/json and /docs/yaml.
# Unset: enabled everywhere except NODE_ENV=production. Set explicitly to override.
SWAGGER_ENABLED=true

# Base URL advertised as the server in the OpenAPI spec (defaults to localhost:$PORT)
API_PUBLIC_URL=http://localhost:3001

# --- IPFS storage (Pinata) ---
# Provider bound in IpfsModule. Currently only "pinata" is implemented.
IPFS_PROVIDER=pinata

# The only secret Pinata needs. Create at https://app.pinata.cloud -> API Keys
# -> New Key, then copy the JWT (not the API key/secret pair).
PINATA_JWT=

# "public" makes uploads retrievable from a gateway, which public verification
# requires. Pinata defaults new uploads to "private".
PINATA_NETWORK=public

# Gateway used to build public URLs. Shared gateway is rate-limited; use your
# dedicated one in production (https://<subdomain>.mypinata.cloud).
IPFS_GATEWAY_URL=https://gateway.pinata.cloud/ipfs
