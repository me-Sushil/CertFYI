# PostgreSQL connection string used by Prisma
DATABASE_URL=postgresql://certfyi_user:iK6Y5rSeDTx4K9DNb3CCw3o8rNxiA5QY@dpg-d9fm3jnavr4c73chpnag-a.singapore-postgres.render.com/certfyi?connection_limit=5&pool_timeout=30&connect_timeout=15
#postgresql://user:password@localhost:5432/certfyi

# Wallet address bootstrapped as the platform Admin (lowercase-compared)
ADMIN_WALLET_ADDRESS=0xC756fF51A6b7da9Ea261e4bA4f048179c98caa32

# Secret used to sign session JWTs - generate with e.g. `openssl rand -base64 32`
JWT_SECRET=replace-with-a-random-32-byte-secret

# Server-side RPC endpoint used to verify on-chain grantRole transactions
# when an admin approves an issuer (not exposed to the client)
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# On-chain contract configuration (falls back to the NEXT_PUBLIC_* equivalents if unset)
CONTRACT_ADDRESS=0x69D2f9880532d171fC76DDF9C6D9D092fDE8abF3
CHAIN_ID=11155111

# Origin allowed to make credentialed requests (CORS)
WEB_APP_URL=http://localhost:3000

# Port the NestJS server listens on
PORT=3001

# --- IPFS storage (Pinata) ---
# Provider bound in IpfsModule. Currently only "pinata" is implemented.
IPFS_PROVIDER=pinata

# The only secret Pinata needs. Create at https://app.pinata.cloud -> API Keys
# -> New Key, then copy the JWT (not the API key/secret pair).
PINATA_JWT=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..aA6MmEA5BjgUkkZAyDogOwMxbOMMPj0guK1NQoxDDlA

# "public" makes uploads retrievable from a gateway, which public verification
# requires. Pinata defaults new uploads to "private" - do not change this unless
# you also change how documents are retrieved.
PINATA_NETWORK=public

# Gateway used to build public URLs. The shared gateway below is rate-limited;
# for production use your dedicated one (https://<subdomain>.mypinata.cloud).
IPFS_GATEWAY_URL=https://olive-genuine-thrush-855.mypinata.cloud
