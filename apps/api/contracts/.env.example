# Hardhat deployment config. Gitignored - never commit this file.

# Sepolia RPC. This keyless public node works without signup.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Private key of the wallet that deploys DocumentAnchor, WITHOUT the 0x prefix.
#
# The constructor grants DEFAULT_ADMIN_ROLE and ADMIN_ROLE to whoever deploys,
# so this must be the key for 0xC756fF51A6b7da9Ea261e4bA4f048179c98caa32 - the
# address set as ADMIN_WALLET_ADDRESS in apps/api/.env. Deploying from any other
# wallet means the admin dashboard cannot approve issuers on-chain.
#
# Export it from MetaMask: account menu -> Account details -> Show private key.
# Use a development-only wallet. Never paste a key that holds real funds.
PRIVATE_KEY=26aa6909fc25d25b38392d606eb498b8b5dc88b337c9ef140ef0d5e6f5fbc5c0

# Optional, only needed for `hardhat verify` to publish source to Etherscan.
ETHERSCAN_API_KEY=
