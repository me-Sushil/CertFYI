# ─── Blockchain ──────────────────────────────────────────────
NEXT_PUBLIC_CONTRACT_ADDRESS=0x742d35Cc6634C0532925a3b844Bc9e7595f42bE
NEXT_PUBLIC_CHAIN_ID=11155111
NEXT_PUBLIC_ENABLE_TESTNETS=true

# ─── API ─────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# ─── WalletConnect (RainbowKit) ──────────────────────────────
# Required for WalletConnect support. Get one at https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ─── Admin Wallets ───────────────────────────────────────────
# Comma-separated list of admin wallet addresses (lowercase, no spaces).
# These wallets automatically get ADMIN role on sign-in.
ADMIN_WALLET_ADDRESSES=0xabc123def456...,0x789ghi...

# ─── JWT ─────────────────────────────────────────────────────
# Secret used to sign JWTs (symmetric, HS256). Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string-min-32-chars
JWT_EXPIRES_IN=2h

# ─── SIWE ────────────────────────────────────────────────────
SIWE_DOMAIN=certfyi.app
SIWE_STATEMENT="Sign in to CertFyi with your Ethereum wallet."

# ─── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/certfyi

# ─── RPC URLs (Infura / Alchemy) ─────────────────────────────
NEXT_PUBLIC_ETH_RPC=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
NEXT_PUBLIC_POLYGON_RPC=https://polygon-rpc.com
NEXT_PUBLIC_ARB_RPC=https://arb1.arbitrum.io/rpc
NEXT_PUBLIC_BASE_RPC=https://mainnet.base.org
NEXT_PUBLIC_OP_RPC=https://mainnet.optimism.io

# ─── Blockchain Explorer ─────────────────────────────────────
ETHERSCAN_API_KEY=

# ─── Email (optional) ────────────────────────────────────────
SENDGRID_API_KEY=

# ─── Monitoring (optional) ───────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

