{
  "name": "@certfyi/monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "CertFyi - Web3 Document Verification Platform",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --no-cache",
    "build": "turbo build",
    "build:web": "turbo build --filter=@certfyi/web",
    "build:api": "turbo build --filter=@certfyi/api",
    "dev:web": "turbo run dev --filter=@certfyi/web",
    "dev:api": "turbo run dev --filter=@certfyi/api",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "test": "turbo test",
    "test:watch": "turbo test -- --watch",
    "clean": "turbo clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "deploy": "turbo deploy"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5.3.0"
  },
  "pnpm": {
    "overrides": {}
  }
}
